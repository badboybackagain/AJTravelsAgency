{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/server.js",
      "buildCommand": "npx prisma generate",
      "bindings": [
        {
          "type": "service",
          "service": "travel-agency",
          "format": "url",
          "env": "FRONTEND_URL"
        }
      ]
    },
    "travel-agency": {
      "root": "travel-agency",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/sitemap.xml",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/robots.txt",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "travel-agency"
      }
    }
  ]
}
