// Pune ↔ Mumbai Private Travel Platform - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Location {
  id        String   @id @default(cuid())
  name      String
  city      String
  state     String   @default("Maharashtra")
  type      String   @default("CITY")
  side      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routesAsPickup Route[]         @relation("PickupLocation")
  routesAsDrop   Route[]         @relation("DropLocation")
  parkingCharges ParkingCharge[]
  waitingCharges WaitingCharge[]
  localVehicles  LocalVehicle[]

  @@map("locations")
}

model Route {
  id               String   @id @default(cuid())
  routeName        String
  pickupLocationId String
  dropLocationId   String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pickupLocation      Location              @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  dropLocation        Location              @relation("DropLocation", fields: [dropLocationId], references: [id])
  fares               Fare[]
  tolls               Toll[]
  vehicleAvailability VehicleAvailability[]
  bookings            Booking[]

  @@unique([pickupLocationId, dropLocationId])
  @@map("routes")
}

model Vehicle {
  id              String   @id @default(cuid())
  name            String
  category        String
  image           String   @default("/assets/sedan.webp")
  description     String?  @db.Text
  seatingCapacity Int
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fares        Fare[]
  availability VehicleAvailability[]
  bookings     Booking[]

  @@map("vehicles")
}

model LocalVehicle {
  id                String   @id @default(cuid())
  city              String   // "Pune" | "Mumbai"
  pickupLocationId  String?
  name              String
  category          String   // "SEDAN" | "SUV" | "LUXURY" | "MINI_BUS" | "TWENTY_SEATER"
  image             String   @default("/assets/sedan.webp")
  description       String?  @db.Text
  seatingCapacity   Int      @default(4)
  durationHours     Int      @default(8) // e.g. 4, 6, 8, 10, 12
  baseFare          Float
  extraHourCharge   Float    @default(150)
  parkingEnabled    Boolean  @default(false)
  parkingAmount     Float    @default(0)
  parkingType       String   @default("FIXED")
  waitingEnabled    Boolean  @default(false)
  freeMinutes       Int      @default(30)
  perHourCharge     Float    @default(0)
  availableQuantity Int      @default(5)
  status            String   @default("AVAILABLE") // "AVAILABLE" | "LIMITED" | "UNAVAILABLE"
  isActive          Boolean  @default(true)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pickupLocation Location? @relation(fields: [pickupLocationId], references: [id])
  bookings       Booking[]

  @@map("local_vehicles")
}

model VehicleAvailability {
  id                String   @id @default(cuid())
  vehicleId         String
  routeId           String
  availableDate     DateTime
  availableFromTime String
  availableToTime   String
  availableQuantity Int      @default(1)
  status            String   @default("AVAILABLE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("vehicle_availability")
}

model Fare {
  id          String   @id @default(cuid())
  routeId     String
  vehicleId   String
  tripType    String   @default("ONE_WAY") // "ONE_WAY" | "ROUND_TRIP"
  baseFare    Float
  perKmFare   Float    @default(0)
  minimumFare Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  fareTolls   FareToll[]
  fareParking FareParking?
  fareWaiting FareWaiting?

  @@unique([routeId, vehicleId, tripType])
  @@map("fares")
}

model FareToll {
  id        String   @id @default(cuid())
  fareId    String
  name      String
  amount    Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fare Fare @relation(fields: [fareId], references: [id], onDelete: Cascade)

  @@map("fare_tolls")
}

model FareParking {
  id           String   @id @default(cuid())
  fareId       String   @unique
  enabled      Boolean  @default(false)
  locationId   String?
  chargingType String   @default("FIXED")
  amount       Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fare Fare @relation(fields: [fareId], references: [id], onDelete: Cascade)

  @@map("fare_parking")
}

model FareWaiting {
  id            String   @id @default(cuid())
  fareId        String   @unique
  enabled       Boolean  @default(false)
  locationId    String?
  freeMinutes   Int      @default(30)
  perHourCharge Float    @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fare Fare @relation(fields: [fareId], references: [id], onDelete: Cascade)

  @@map("fare_waiting")
}

model Toll {
  id              String   @id @default(cuid())
  name            String
  routeId         String
  amount          Float
  vehicleCategory String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("tolls")
}

model ParkingCharge {
  id              String   @id @default(cuid())
  locationId      String
  vehicleCategory String
  amount          Float
  chargingType    String   @default("FIXED")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("parking_charges")
}

model WaitingCharge {
  id              String   @id @default(cuid())
  locationId      String
  vehicleCategory String
  freeMinutes     Int      @default(30)
  perHourCharge   Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("waiting_charges")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  passwordHash String
  role         String   @default("CUSTOMER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]

  @@map("users")
}

model Booking {
  id               String    @id @default(cuid())
  routeId          String?
  vehicleId        String?
  localVehicleId   String?
  pickupLocationId String?
  dropLocationId   String?
  city             String?
  tripType         String    @default("ONE_WAY") // "ONE_WAY" | "ROUND_TRIP" | "LOCAL"
  pickupDate       DateTime
  pickupTime       String
  returnDate       DateTime?
  returnTime       String?
  durationHours    Int?
  passengers       Int       @default(1)
  pickupAddress    String?   @db.Text
  dropAddress      String?   @db.Text
  fareTotal        Float
  fareDetails      String?   @db.Text
  status           String    @default("PENDING") // "PENDING" | "CONFIRMED" | "CANCELLED" | "COMPLETED"
  customerName     String?
  customerPhone    String?
  customerEmail    String?
  notes            String?   @db.Text
  enquiryId        String?
  quoteId          String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  route        Route?        @relation(fields: [routeId], references: [id])
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  localVehicle LocalVehicle? @relation(fields: [localVehicleId], references: [id])
  quote        Quote?        @relation("BookingQuote")

  @@map("bookings")
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@map("audit_logs")
}

model IntegrationSetting {
  id                String    @id @default(cuid())
  service           String    @unique @default("WHATSAPP")
  provider          String    @default("WASMS") // "WASMS"
  apiUrl            String?   @default("https://wasms.nirosha.org")
  apiKey            String?   @db.Text
  senderId          String?   // WhatsApp Account ID
  destinationNumber String?
  isEnabled         Boolean   @default(false)
  notifyBookings    Boolean   @default(true)
  notifyEnquiries   Boolean   @default(true)
  lastStatus        String    @default("UNCONFIGURED") // "CONNECTED" | "DISCONNECTED" | "ERROR" | "UNCONFIGURED"
  lastVerifiedAt    DateTime?
  lastError         String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("integration_settings")
}

model OtpChallenge {
  id                String    @id @default(cuid())
  phoneNumber       String
  purpose           String    @default("BOOKING_VERIFICATION")
  status            String    @default("PENDING") // "PENDING" | "VERIFIED" | "CONSUMED" | "EXPIRED"
  verificationToken String?   @unique
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5)
  resendCount       Int       @default(0)
  provider          String    @default("WASMS")
  providerRef       String?
  expiresAt         DateTime
  verifiedAt        DateTime?
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([phoneNumber, status])
  @@map("otp_challenges")
}

model Enquiry {
  id          String   @id @default(cuid())
  name        String
  phone       String
  pickup      String
  destination String
  travelDate  String?
  vehicle     String?
  message     String?  @db.Text
  status      String   @default("NEW") // "NEW" | "CONTACTED" | "RESOLVED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes      Quote[]

  @@map("enquiries")
}

model Quote {
  id              String    @id @default(cuid())
  enquiryId       String
  bookingId       String?   @unique
  vehicleCategory String    // "SEDAN" | "SUV" | "INNOVA_CRYSTA" | "TEMPO_TRAVELLER" | "OTHER"
  vehicleName     String?   // e.g. "Toyota Innova Crysta (6+1)"
  tripType        String    @default("ONE_WAY") // "ONE_WAY" | "ROUND_TRIP" | "LOCAL"
  baseFare        Float
  tollCharges     Float     @default(0)
  driverAllowance Float     @default(0)
  parkingCharges  Float     @default(0)
  totalFare       Float
  inclusions      String?   @db.Text
  exclusions      String?   @db.Text
  terms           String?   @db.Text
  status          String    @default("QUOTED") // "QUOTED" | "ACCEPTED" | "DECLINED" | "EXPIRED" | "SUPERSEDED"
  quoteToken      String    @unique
  validUntil      DateTime
  sentAt          DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  declinedReason  String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enquiry         Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  booking         Booking?  @relation("BookingQuote", fields: [bookingId], references: [id])

  @@index([enquiryId])
  @@index([quoteToken])
  @@map("quotes")
}

model NotificationLog {
  id               String   @id @default(cuid())
  channel          String   @default("WHATSAPP")
  eventType        String   // "ENQUIRY" | "BOOKING_CREATED" | "BOOKING_STATUS" | "ADMIN_TEST"
  referenceId      String?  // Enquiry ID or Booking ID
  recipient        String
  status           String   // "SENT" | "ACCEPTED" | "FAILED" | "SKIPPED_DISABLED"
  providerResponse String?  @db.Text
  errorMessage     String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([referenceId, eventType])
  @@map("notification_logs")
}

model SeoMeta {
  id              String   @id @default(cuid())
  pageKey         String   @unique  // e.g. "home", "fare", "booking"
  pageLabel       String            // Human-readable label, e.g. "Home Page"
  pageUrl         String            // Canonical path, e.g. "/"
  seoTitle        String?  @db.Text
  metaDescription String?  @db.Text
  canonicalUrl    String?
  isIndexable     Boolean  @default(true)
  ogTitle         String?  @db.Text
  ogDescription   String?  @db.Text
  ogImage         String?
  slug            String?           // Custom slug override (where supported)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("seo_meta")
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  mimeType     String
  fileSize     Int
  category     String   @default("general") // "vehicles" | "blogs" | "destinations" | "services" | "general"
  altText      String?  @db.Text
  title        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
  @@map("media_assets")
}

